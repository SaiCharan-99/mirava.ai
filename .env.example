# Copy to .env for local development. Never commit .env.

# --- Environment ---
ENV=local                         # local | cloud
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1            # app + data region (Mumbai)
VERTEX_LOCATION=global            # only if LLM_BACKEND=vertex

# --- Model backends (Gemini 3 only) ---
LLM_BACKEND=fake                  # fake (tests/offline) | openrouter (default for real calls) | vertex
DECISION_BACKEND=fake             # fake | openrouter (Gemini 3.5 Flash-Lite, batched)
OPENROUTER_API_KEY=               # team key from https://openrouter.ai/keys (Secret Manager "openrouter-api-key" in cloud)
OPENROUTER_API_KEY_FALLBACK=      # optional backup key, used when the main key runs out (Secret Manager "openrouter-api-key-fallback")
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=mirava.ai
MODEL_PRO_ID=google/gemini-3.1-pro-preview
MODEL_FLASH_ID=google/gemini-3.6-flash
MODEL_LITE_ID=google/gemini-3.5-flash-lite
MODEL_EMBED_ID=google/gemini-embedding-001
ENGINE_REASONING_EFFORT=low       # reasoning effort for background engine calls
LLM_CONCURRENCY=32                # model calls in flight from the engine
DECISION_BATCH_SIZE=32

# --- Budget (see config/budget.yaml for per-class caps) ---
DAILY_CAP_USD=15                  # background world, per real day
INTERACTIVE_CAP_USD=5             # Insights assistant, polls, interviews, per real day

# --- World ---
WORLD_AGENTS=1000
WORLD_SEED=4271
WORLD_SECONDS_PER_SIM_DAY=3600    # 1 sim day = 1 real hour (local dev: 120)
WORLD_MAP=assets/maps/indiranagar.tmj
CHECKPOINT_EVERY_SIM_MINUTES=60
ENGINE_URL=http://localhost:8100  # api → world-engine commands
MAX_MESSAGES_PER_PERSON=10
STRANGER_MAX_MESSAGES_PER_PERSON=4

# --- Data ---
BQ_BACKEND=duckdb                 # duckdb | bigquery
BQ_DATASET=mirava
DUCKDB_PATH=.data/mirava.duckdb
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCS_BUCKET_UPLOADS=your-project-id-mirava-uploads
GCS_BUCKET_WORLDS=your-project-id-mirava-worlds
GCS_BUCKET_EXPORTS=your-project-id-mirava-exports
LOCAL_FILES_DIR=.data/files
PUBSUB_TOPIC_EVENTS=world-events
PUBSUB_TOPIC_TEXTS=world-texts
EVENT_SINK=local                  # local (DuckDB) | pubsub

# --- Safety ---
MODEL_ARMOR_ENABLED=false
MODEL_ARMOR_TEMPLATE=             # projects/mirava-ai-hack/locations/asia-south1/templates/mirava-screen (cloud); full path or id; templates/mirava-screen

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_LIVE_WS_URL=ws://localhost:8100/live
VITE_FIREBASE_PROJECT_ID=your-project-id
