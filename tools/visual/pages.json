    {
      "name": "09-profile-memory",
      "route": "world",
      "phase": 3,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'memory')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "10-world-watching",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "click": "[data-testid=side-tab-watching]"
        },
        {
          "wait": 200
        }
      ]
    },
    {
      "name": "11-world-products",
