{
  "_doc": "Screens compared between the mockup (docs/ui-mockup.html) and the real app. Both targets must expose the same data-testid attributes and the same window.__ll hooks in visual-test mode. Fixtures for the app: node extract-fixtures.mjs. See tools/visual/README.md and docs/INTERFACES.md \u00a76.",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "targets": {
    "mockup": {
      "base": "docs/ui-mockup.html",
      "query": "?freeze=1",
      "router": "hash",
      "outDir": "docs/ui-reference"
    },
    "app": {
      "base": "http://localhost:5173",
      "query": "?visualTest=1",
      "router": "path",
      "outDir": "artifacts/visual/app"
    },
    "selftest": {
      "base": "docs/ui-mockup.html",
      "query": "?freeze=1",
      "router": "hash",
      "outDir": "artifacts/visual/app"
    }
  },
  "defaultMask": [
    "[data-testid=event-ticker]"
  ],
  "defaultMaxLayout": 0.06,
  "screens": [
    {
      "name": "01-globe",
      "route": "globe",
      "phase": 1,
      "actions": [
        {
          "wait": 400
        }
      ],
      "mask": []
    },
    {
      "name": "02-world",
      "route": "world",
      "phase": 1
    },
    {
      "name": "03-world-hover",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "eval": "window.__ll.hoverAgent(window.__ll.featured())"
        },
        {
          "wait": 300
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "04-profile-overview",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'overview')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "05-profile-relations",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'relations')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "06-profile-possessions",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'possessions')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "07-profile-thoughts",
      "route": "world",
      "phase": 3,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'thoughts')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
    },
    {
      "name": "08-profile-conversations",
      "route": "world",
      "phase": 3,
      "actions": [
        {
          "eval": "window.__ll.openAgent(window.__ll.featured(),'conversations')"
        },
        {
          "wait": 400
        }
      ],
      "maxLayout": 0.1,
      "maxEdge": 0.1
