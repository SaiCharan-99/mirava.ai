      ]
    },
    {
      "name": "13-world-look",
      "route": "world",
      "phase": 2,
      "actions": [
        {
          "eval": "window.__ll.focus(window.__ll.featured())"
        }
      ],
      "mask": [],
      "maxLayout": 0.4,
      "reviewOnly": true,
      "hide": [
        "[data-testid=mockup-only]"
